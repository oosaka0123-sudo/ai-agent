# ==============================================================
# 環境変数サンプルファイル
# ==============================================================
# 使い方:
#   1. このファイルをコピーして `.env` を作成する
#        cp .env.example .env
#   2. `.env` に実際のAPIキーなどを記入する
#
# 重要: `.env` は絶対にGitへコミットしないでください。
#       (.gitignore で除外設定済みです)
# ==============================================================

# --- LLM / AIエージェント用 APIキー ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Google Vertex AI（scripts/generate_media.py が使用） ---
# プロジェクトID・リージョンはここに書いてよい（秘密情報ではない）。
GOOGLE_CLOUD_PROJECT=rss7-ai-media
GOOGLE_CLOUD_LOCATION=us-central1
# 認証は原則 Application Default Credentials を使う
# （`gcloud auth application-default login` をローカル/コンテナで実行）。
# サービスアカウント鍵ファイルを使う場合のみ、そのファイルへの絶対パスを設定する。
# 鍵ファイル自体は絶対にリポジトリに置かない・コミットしないこと。
GOOGLE_APPLICATION_CREDENTIALS=

# --- Google Media MCP Server（mcp_server/、Cloud Run想定） ---
# 生成物の正式保存先。バケット自体は事前に作成しておくこと（gcloud storage buckets create）。
GOOGLE_MEDIA_GCS_BUCKET=
# このMCPエンドポイント自体を呼べるようにするための共有トークン（Vertex AI呼び出しは
# 課金対象のため、未認証で誰でも叩ける状態にしないこと）。ローカル開発でこれを空にすると
# 認証なしで動くが、デプロイ環境では必ず設定する。
GOOGLE_MEDIA_MCP_TOKEN=
# MCP SDKのDNS rebinding対策は既定でHost許可リストが空＝すべて拒否になる。
# デプロイ後、実際のCloud Run URL（またはカスタムドメイン）のホスト名をここに設定しないと
# 正規のリクエストも含めて全滅する。カンマ区切りで複数可。
GOOGLE_MEDIA_MCP_ALLOWED_HOSTS=
GOOGLE_MEDIA_MCP_ALLOWED_ORIGINS=
# 課金事故防止の上限（既定値は保守的。必要に応じて調整）。
GOOGLE_MEDIA_MAX_IMAGE_COUNT=4
GOOGLE_MEDIA_MAX_VIDEO_DURATION_SECONDS=8
GOOGLE_MEDIA_MAX_RETRY_ATTEMPTS=2
GOOGLE_MEDIA_MAX_CONCURRENT_PER_PROJECT=1
# 0またはコメントアウトのままなら projects/registry.json の max_parallel_projects を使う。
GOOGLE_MEDIA_GLOBAL_MAX_CONCURRENT=0

# --- アプリケーション共通設定 ---
APP_ENV=development
LOG_LEVEL=info

# --- 通知・外部サービス連携（今後の拡張用。必要になったら追加） ---
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=

# --- Web操作・外部API連携（今後の拡張用） ---
# SEARCH_API_KEY=
# NEWS_API_KEY=
