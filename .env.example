# ==============================================================
# 環境変数サンプルファイル
# ==============================================================
# 使い方:
#   1. このファイルをコピーして `.env` を作成する
#        cp .env.example .env
#   2. `.env` に実際のAPIキーなどを記入する
#
# 重要: `.env` は絶対にGitへコミットしないでください。
#       (.gitignore で除外設定済みです)
# ==============================================================

# --- LLM / AIエージェント用 APIキー ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- アプリケーション共通設定 ---
APP_ENV=development
LOG_LEVEL=info

# --- 通知・外部サービス連携（今後の拡張用。必要になったら追加） ---
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=

# --- Web操作・外部API連携（今後の拡張用） ---
# SEARCH_API_KEY=
# NEWS_API_KEY=
