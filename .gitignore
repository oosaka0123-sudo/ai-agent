.env.*
!.env.example
*.pem
*.key
*secret*
!**/secret*/README.md
credentials.json
*.credentials

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ==============================
# Node.js
# ==============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
dist/
build/

